# M1 requires no secrets. Future credentials belong in Worker secrets, never VITE_*.
# APP_ENV is defined per environment in wrangler.jsonc.
# M2A local key generation: npm run mcp:local:init (writes ignored .dev.vars).
# MCP_SERVICE_SECRET=<generate-locally-or-store-as-worker-secret>
# M2B operator token belongs only in the preview Worker's secret store.
# M2B_OPERATOR_TOKEN=<64-lowercase-hex-characters-from-32-random-bytes>
# Public local/production probe routes stay disabled regardless of this value.
