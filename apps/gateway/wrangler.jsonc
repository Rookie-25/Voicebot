{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voice-bot-gateway-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"],
  },
  "vars": {
    "APP_ENV": "local",
    "CANDIDATE_ID": "fictional-alex",
    "CONTENT_VERSION": "fixture-v1",
    "LOCAL_MCP_DIAGNOSTICS": "true",
  },
  "services": [
    {
      "binding": "KNOWLEDGE_MCP",
      "service": "voice-bot-knowledge-local",
    },
  ],
  "env": {
    "preview": {
      "name": "voice-bot-gateway-preview",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/healthz"],
      },
      "vars": {
        "APP_ENV": "preview",
        "LIVE_AI_ENABLED": "false",
        "LLM_MODEL": "gpt-5.6-terra",
        "DAILY_BUDGET_CENTS": "100",
        "CONTENT_MODE": "fictional",
        "LOCAL_MCP_DIAGNOSTICS": "false",
        "CANDIDATE_ID": "fictional-alex",
        "CONTENT_VERSION": "fixture-v1",
      },
      "durable_objects": {
        "bindings": [{ "name": "BUDGET", "class_name": "InterviewBudget" }],
      },
      "migrations": [{ "tag": "interview-budget-v1", "new_sqlite_classes": ["InterviewBudget"] }],
      "services": [
        {
          "binding": "KNOWLEDGE_MCP",
          "service": "voice-bot-knowledge-preview",
        },
      ],
    },
    "production": {
      "name": "voice-bot-gateway",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "LOCAL_MCP_DIAGNOSTICS": "false",
        "CANDIDATE_ID": "UNCONFIGURED",
        "CONTENT_VERSION": "UNCONFIGURED",
      },
      "services": [
        {
          "binding": "KNOWLEDGE_MCP",
          "service": "voice-bot-knowledge",
        },
      ],
    },
  },
  "compatibility_flags": ["nodejs_compat"],
}
