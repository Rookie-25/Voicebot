{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voice-bot-knowledge-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "APP_ENV": "local",
    "CANDIDATE_ID": "fictional-alex",
    "CONTENT_VERSION": "fixture-v1",
    "ALLOW_SYNTHETIC_DATA": "true",
  },
  "env": {
    "preview": {
      "name": "voice-bot-knowledge-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "APP_ENV": "preview",
        "CANDIDATE_ID": "fictional-alex",
        "CONTENT_VERSION": "fixture-v1",
        "ALLOW_SYNTHETIC_DATA": "true",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voice-bot-knowledge-preview",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "voice-bot-knowledge",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "APP_ENV": "production",
        "CANDIDATE_ID": "UNCONFIGURED",
        "CONTENT_VERSION": "UNCONFIGURED",
        "ALLOW_SYNTHETIC_DATA": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "voice-bot-knowledge-production",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voice-bot-knowledge-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
}
